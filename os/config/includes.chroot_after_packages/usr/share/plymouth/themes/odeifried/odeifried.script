Window.SetBackgroundTopColor(0.03, 0.04, 0.11);
Window.SetBackgroundBottomColor(0.10, 0.07, 0.28);
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30);
dot_image = Image("dot.png");
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetX(Window.GetWidth() / 2 - 35 + i * 28);
    dots[i].SetY(Window.GetHeight() / 2 + 90);
}
tick = 0;
fun refresh() {
    tick++;
    for (i = 0; i < 3; i++)
        dots[i].SetOpacity(0.25 + 0.75 * Math.Abs(Math.Sin(tick / 18 - i * 0.7)));
}
Plymouth.SetRefreshFunction(refresh);
